// WiseStyle data model.
//
// Role (User.role) and Payment.type are plain Strings, not Prisma enums:
// The validated union types live in the domain layer (src/domain/entities.ts)
// and are enforced by zod at the service boundary.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String
  role         String // "ADMIN" | "MANAGER" | "TAILOR"
  tailorId     String? @unique
  tailor       Tailor? @relation(fields: [tailorId], references: [id])

  createdAt DateTime @default(now())

  @@index([email])
  @@index([role])
}

model Customer {
  id          String @id @default(cuid())
  customerNumber String @unique

  name             String
  gender           String
  phone            String
  whatsapp         String?
  email            String?
  address          String?
  state            String?
  city             String?
  occupation       String?
  preferredStyle   String?
  preferredFabric  String?
  preferredColours String?
  occasion         String?
  interests        String?
  returning        Boolean @default(false)
  preferredStyleImage String?
  measurements     String? // JSON-encoded measurements object

  // Referral tracking
  referrerId String?
  referrer   Referrer? @relation(fields: [referrerId], references: [id])

  jobs Job[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([phone])
  @@index([createdAt])
  @@index([referrerId])
}

model Tailor {
  id           String @id @default(cuid())
  tailorNumber String @unique

  name       String
  phone      String?
  address    String?
  dateJoined DateTime?
  rating     Int       @default(5)
  notes      String?

  jobs         Job[]
  wagePayments WagePayment[]
  user         User?

  createdAt DateTime @default(now())
}

model WagePayment {
  id        String   @id @default(cuid())
  tailorId  String
  tailor    Tailor   @relation(fields: [tailorId], references: [id], onDelete: Cascade)
  weekStart DateTime
  amount    Float
  note      String?
  datePaid  DateTime @default(now())
}

model Job {
  id        String @id @default(cuid())
  jobNumber String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  style      String
  styleOther String?

  dateReceived         DateTime?
  startDate            DateTime?
  completionDate       DateTime?
  actualCompletionDate DateTime?

  contractPrice Float
  depositPaid   Float  @default(0)
  materials     String // JSON-encoded MaterialsState (see src/domain/entities.ts)
  measurements  String? // JSON-encoded measurements object (overrides customer defaults)

  tailorId String?
  tailor   Tailor? @relation(fields: [tailorId], references: [id])

  progress Int     @default(0)
  notes    String?
  
  // Job completion satisfaction (1-5 stars, set when job is marked as completed)
  satisfactionRating Int?

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([tailorId])
  @@index([dateReceived])
  @@index([completionDate])
  @@index([createdAt])
}

model Payment {
  id     String @id @default(cuid())
  jobId  String
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  date   DateTime
  amount Float
  method String?
  note   String?
  type   String // "payment" | "refund"

  createdAt DateTime @default(now())
}

model MaterialType {
  id          String @id @default(cuid())
  key         String @unique // lowercase_with_underscores identifier
  label       String @unique // Display name (e.g., "Sewing Thread")
  unit        String         // Unit of measurement (e.g., "pcs", "yards")
  maxQuantity Int            // Maximum quantity allowed (1-100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([label])
}

model Referrer {
  id             String @id @default(cuid())
  referrerNumber String @unique

  name    String
  phone   String
  email   String?
  address String?
  
  // Optional bank details for future commission payments
  bankName          String?
  accountName       String?
  accountNumber     String?
  
  notes String?

  customers Customer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([createdAt])
}
